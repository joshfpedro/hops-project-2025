\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {\replaced {Disease transmission network among sampled hop yards}{Network of sampled hop yards by centrality quantile}}. \replaced {A representative sample of hop yards (one per out-degree centrality quantile, 2017) connected by directed transmission edges. Node size is proportional to yard area. Green nodes denote cultivars lacking \textit  {R6} resistance (susceptible to both strains); blue nodes denote cultivars possessing \textit  {R6} (susceptible to \textit  {V6}-virulent strains only). Solid gold edges indicate \textit  {V6}-virulent source infection; dashed gray edges indicate non-\textit  {V6}-virulent source infection. Edge width reflects directed transmission weight (Equation \ref {eq:1}); edges are omitted where strain--cultivar incompatibility precludes transmission.}{This network visualization shows a representative sample of hop yards (one per centrality quantile) connected by inferred disease transmission pathways. Node sizes are proportional to yard area, with colors indicating disease status. Edge colors and styles represent the source infection status, with edge widths proportional to directed transmission weights based on area, wind patterns, and distance. The network illustrates the spatial structure of disease transmission potential across the production landscape.} \added {Refer to Section 3 for the definition of out-degree centrality and the quantile classification used.}\relax }}{9}{figure.caption.19}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced: \truncate {\Changestruncatewidth }{Disease transmission network among sampled hop yards}}{9}{section*.23}\protected@file@percent }
